# ==============================================================================
# JobHunt AI AutoFiller — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# NOTE: In production, users enter their Groq API key directly in the Side Panel UI,
# which is stored safely in sandboxed `chrome.storage.local`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud API Key (Optional default for dev/testing)
# Obtain your free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Client ID (Required for chrome.identity Google Sign-In)
# Steps to obtain:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# 2. Create Credentials -> OAuth client ID -> Application type: "Chrome extension"
# 3. Enter your unpacked extension ID from chrome://extensions
# 4. Paste the generated client ID below (also placed in manifest.json "oauth2.client_id")
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Default AI Inference Model
# Recommended: llama-3.3-70b-versatile
# Fast / Low-latency alternative: llama-3.1-8b-instant
# ------------------------------------------------------------------------------
VITE_GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
